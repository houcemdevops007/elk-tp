<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml — descripteur de déploiement de ShopFlow ({{STUDENT_ID}}).

  Le servlet est déclaré par annotation (@WebServlet) : ce fichier ne sert
  qu'à fixer la version de la spécification et le délai d'expiration des
  sessions. Un délai trop long fait croître la mémoire sans utilisateurs
  réels : c'est une cause classique de fuite (chapitre 2, pathologie 1).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

  <display-name>ShopFlow API — {{STUDENT_ID}}</display-name>

  <session-config>
    <session-timeout>15</session-timeout>
  </session-config>

</web-app>
